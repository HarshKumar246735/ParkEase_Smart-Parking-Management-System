{
  "name": "parkease-server",
  "version": "1.0.0",
  "private": true,
  "description": "ParkEase - Smart Mall Parking Management System (API)",
  "type": "module",
  "main": "server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:data": "node scripts/seedParkingData.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed": "node scripts/seedParkingData.js && node scripts/seedAdmin.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "smoke": "node scripts/e2eSmoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}
